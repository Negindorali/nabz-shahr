# این فایل را به .env کپی کن و مقدارها را عوض کن. خود .env در git نمی‌رود.

# --- MinIO (NBZ-101)
MINIO_ROOT_USER=nabz
MINIO_ROOT_PASSWORD=change-me-please
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
LANDING_BUCKET=landing
LAKE_BUCKET=lake

# --- Spark (NBZ-102)
SPARK_MASTER_URL=spark://localhost:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g

# --- Iceberg catalog و Trino (NBZ-103)
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://lake/warehouse
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=nabz

# --- Kafka (NBZ-401)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
TRIPS_TOPIC=trips.events
DLQ_TOPIC=trips.events.dlq
ALERTS_TOPIC=alerts.surge

# --- بازپخش‌کننده (NBZ-402)
REPLAY_SPEED=60

# --- Airflow (NBZ-501)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-please
AIRFLOW_PORT=8088

# --- Superset و Grafana (NBZ-601, NBZ-602)
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_PORT=8089
GRAFANA_ADMIN_PASSWORD=change-me-please
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- منبع داده
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
TLC_ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
